# Copy to .env and fill in. Never commit a real .env.
PORT=3000

# Secret for signing admin session cookies — set a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# SQLite file location (defaults to ./data/chatbot.db)
DB_PATH=

# ---- Database ----
# Set to a Postgres connection string (e.g. from Render/Supabase/Neon) for
# production persistence; unset = local SQLite (./data/chatbot.db or DB_PATH).
# Example: postgresql://user:password@host:5432/chatbot
DATABASE_URL=

# Set to 1 when running behind a reverse proxy / load balancer so rate
# limiting sees the real client IP (via X-Forwarded-For).
TRUST_PROXY=

# Key used to encrypt per-business LLM API keys at rest (AES-256-GCM).
# REQUIRED in production — set a long random string. If unset or changed,
# previously stored keys cannot be decrypted and LLM fallback stays disabled.
ENCRYPTION_KEY=

# ---- Rate limiting (requests per minute, sliding window) ----
# Set any to 0 to disable (not recommended in production).
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_CONFIG_PER_MIN=120
RATE_LIMIT_WEBHOOK_PER_MIN=60
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_FEEDBACK_PER_MIN=30
RATE_LIMIT_NUDGE_PER_MIN=60

# ---- LLM (optional) ----
# Any OpenAI-compatible chat completions endpoint works:
# OpenAI, Azure OpenAI, Ollama (http://localhost:11434/v1), vLLM, OpenRouter, Together...
LLM_ENABLED=1
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Per-business overrides can also be set from the admin panel (Settings -> AI brain).

# ---- Stripe billing (self-serve signup, optional) ----
# When ALL of these are set, the pricing page (/pricing/) shows Subscribe
# buttons that create Stripe Checkout Sessions (subscription + one-time setup
# fee). The webhook auto-provisions the business + admin on payment.
# When unset, /pricing/ shows a "Contact us" mailto CTA instead, and the
# billing endpoints return 503 { error: 'billing not configured' }.
# Create the prices in the Stripe Dashboard (recurring, monthly, USD):
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_SCALE=price_...
# Signing secret for the webhook endpoint (Stripe Dashboard -> Developers -> Webhooks,
# endpoint: https://YOUR-HOST/api/billing/webhook, event: checkout.session.completed):
STRIPE_WEBHOOK_SECRET=

# ---- Messaging channels (WhatsApp + Messenger, optional) ----
# When unset, the channel webhooks stay live but sending is skipped and
# inbound messages are not delivered — everything is inert without keys.
# Setup guide: README -> "Messaging channels (Meta app setup)".
# Verify token you invent and paste into the Meta app's webhook config:
WHATSAPP_VERIFY_TOKEN=
# Long-lived token from Meta app -> WhatsApp -> API Setup:
WHATSAPP_TOKEN=
# Phone number ID from WhatsApp -> API Setup (can also be set per-business
# in Admin -> Settings -> Messaging channels; per-business wins):
WHATSAPP_PHONE_NUMBER_ID=
# Verify token for the Messenger webhook (may be the same as above):
META_VERIFY_TOKEN=
# Page access token from Meta app -> Messenger -> API Setup:
META_PAGE_ACCESS_TOKEN=

# ---- Agentic actions rate limiting ----
RATE_LIMIT_CHANNEL_PER_MIN=120
