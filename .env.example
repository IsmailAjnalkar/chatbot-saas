# Copy to .env and fill in. Never commit a real .env.
PORT=3000

# Secret for signing admin session cookies — set a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# SQLite file location (defaults to ./data/chatbot.db)
DB_PATH=

# Set to 1 when running behind a reverse proxy / load balancer so rate
# limiting sees the real client IP (via X-Forwarded-For).
TRUST_PROXY=

# Key used to encrypt per-business LLM API keys at rest (AES-256-GCM).
# REQUIRED in production — set a long random string. If unset or changed,
# previously stored keys cannot be decrypted and LLM fallback stays disabled.
ENCRYPTION_KEY=

# ---- Rate limiting (requests per minute, sliding window) ----
# Set any to 0 to disable (not recommended in production).
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_CONFIG_PER_MIN=120
RATE_LIMIT_WEBHOOK_PER_MIN=60
RATE_LIMIT_LOGIN_PER_MIN=10

# ---- LLM (optional) ----
# Any OpenAI-compatible chat completions endpoint works:
# OpenAI, Azure OpenAI, Ollama (http://localhost:11434/v1), vLLM, OpenRouter, Together...
LLM_ENABLED=1
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Per-business overrides can also be set from the admin panel (Settings -> AI brain).
